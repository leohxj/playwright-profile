{
  "name": "playwright-profile",
  "version": "0.1.0",
  "description": "Private versioned browser state snapshots through unmodified playwright-cli",
  "type": "module",
  "bin": {
    "playwright-profile": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/sqlite_snapshot.py",
    "skills",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && node scripts/verify.mjs",
    "verify:upstream": "npm run build && node scripts/verify-upstream.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@playwright/cli": "0.1.24",
    "commander": "^14.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
